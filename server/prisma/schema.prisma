datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum PlanTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  PAST_DUE
}

enum Category {
  ACADEMIC_CLASS
  STUDY_DEEP
  TRADING
  GYM
  READING
  PERSONAL
  REST
}

enum SlotStatus {
  PENDING
  COMPLETED
  CANCELLED
  FREED
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String?
  passwordHash     String?
  googleId         String?           @unique
  role             Role              @default(USER)
  plan             PlanTier          @default(FREE)
  telegramChatId   String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  subscription     Subscription?
  habitDefinitions HabitDefinition[]
  habitLogs        HabitLog[]
  books            Book[]
  projectTasks     ProjectTask[]
  exams            Exam[]
  plannedSlots     PlannedSlot[]
  fixedRoutines    FixedRoutine[]
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Exam {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  type      String
  date      DateTime
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
}

model FixedRoutine {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  category   Category
  dayOfWeek  Int
  startTime  String
  endTime    String
  isFlexible Boolean  @default(false)
}

model WeeklyPlan {
  id        String        @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  isActive  Boolean       @default(true)
  slots     PlannedSlot[]
  createdAt DateTime      @default(now())
}

model PlannedSlot {
  id           String     @id @default(uuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlanId String
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  title        String
  category     Category
  subject      String?
  start        DateTime
  end          DateTime
  status       SlotStatus @default(PENDING)
  isAutoSlot   Boolean    @default(false)
}

model HabitLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitKey   String
  date       DateTime @db.Date
  completed  Boolean  @default(true)
  isFrozen   Boolean  @default(false) // Indica si el día fue congelado por viaje/descanso
  freezeNote String?                   // Ej: "Viaje a Malargüe", "Feriado"
  createdAt  DateTime @default(now())

  @@unique([habitKey, date])
}

model AcademicProgress {
  id           String @id @default(uuid())
  subject      String @unique
  progressPerc Int    @default(0)
}

model AcademicSubject {
  id           String   @id @default(uuid())
  name         String   @unique
  progressPerc Int      @default(0)
  syllabus     Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HabitDefinition {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String   @unique
  name       String
  category   Category
  targetDays Int[]    // [1,2,3,4,5] etc.
  streakDays Int      @default(0)
  createdAt  DateTime @default(now())
}

model Book {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  author         String
  totalPages     Int
  currentPage    Int      @default(0)
  status         String   @default("READING") // READING, QUEUED, FINISHED
  category       String   @default("Técnico")
  dailyTargetMin Int      @default(30)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ProjectTask {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  system    String   @default("General") // LifeFlow, FitTracker, Konta, Trading/Bots, etc.
  status    String   @default("TODO")    // TODO, IN_PROGRESS, DONE
  priority  String   @default("IMPORTANT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
