datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  ACADEMIC_CLASS
  STUDY_DEEP
  TRADING
  GYM
  READING
  PERSONAL
  REST
}

enum SlotStatus {
  PENDING
  COMPLETED
  CANCELLED
  FREED
}

model Exam {
  id        String   @id @default(uuid())
  subject   String
  type      String
  date      DateTime
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
}

model FixedRoutine {
  id         String   @id @default(uuid())
  title      String
  category   Category
  dayOfWeek  Int
  startTime  String
  endTime    String
  isFlexible Boolean  @default(false)
}

model WeeklyPlan {
  id        String        @id @default(uuid())
  startDate DateTime
  endDate   DateTime
  isActive  Boolean       @default(true)
  slots     PlannedSlot[]
  createdAt DateTime      @default(now())
}

model PlannedSlot {
  id           String     @id @default(uuid())
  weeklyPlanId String
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
  title        String
  category     Category
  subject      String?
  start        DateTime
  end          DateTime
  status       SlotStatus @default(PENDING)
  isAutoSlot   Boolean    @default(false)
}

model HabitLog {
  id         String   @id @default(uuid())
  habitKey   String
  date       DateTime @db.Date
  completed  Boolean  @default(true)
  isFrozen   Boolean  @default(false) // Indica si el día fue congelado por viaje/descanso
  freezeNote String?                   // Ej: "Viaje a Malargüe", "Feriado"
  createdAt  DateTime @default(now())

  @@unique([habitKey, date])
}

model AcademicProgress {
  id           String @id @default(uuid())
  subject      String @unique
  progressPerc Int    @default(0)
}

model AcademicSubject {
  id           String   @id @default(uuid())
  name         String   @unique
  progressPerc Int      @default(0)
  syllabus     Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HabitDefinition {
  id         String   @id @default(uuid())
  key        String   @unique
  name       String
  category   Category
  targetDays Int[]    // [1,2,3,4,5] etc.
  streakDays Int      @default(0)
  createdAt  DateTime @default(now())
}

model Book {
  id          String   @id @default(uuid())
  title       String
  author      String
  totalPages  Int
  currentPage Int      @default(0)
  status      String   @default("READING") // READING, QUEUED, FINISHED
  category    String   @default("Técnico")
  dailyTargetMin Int   @default(30)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectTask {
  id        String   @id @default(uuid())
  title     String
  system    String   @default("General") // LifeFlow, FitTracker, Konta, Trading/Bots, etc.
  status    String   @default("TODO")    // TODO, IN_PROGRESS, DONE
  priority  String   @default("IMPORTANT")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
